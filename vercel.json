{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "cleanUrls": true,
  "redirects": [
    { "source": "/zh", "destination": "/", "permanent": true },
    { "source": "/zh/:path*", "destination": "/:path*", "permanent": true }
  ]
}
